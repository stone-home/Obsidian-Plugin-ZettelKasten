branches:
  - trunk
repositoryUrl: "https://github.com/stone-home/Obsidian-Plugin-ZettelKasten"
plugins:
  - "@semantic-release/commit-analyzer"
  - "@semantic-release/release-notes-generator"
  - "@semantic-release/npm"
  - ["@semantic-release/exec", { "prepareCmd": "npm run version" }]
  - - "@semantic-release/git"
    - assets:
        - "package.json"
        - "manifest.json"
        - "versions.json"
      message: "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
  - - "@semantic-release/github"
    - assets:
	    - { "path": "main.js", "label": "main.js" }
        - { "path": "manifest.json", "label": "manifest.json" }
        - { "path": "styles.css", "label": "styles.css" }
